# Application Settings
APP_ENV=production
APP_NAME="Student Task Manager"

# Database Connection (Injeksi melalui Azure Portal Application Settings)
# Drivers yang didukung: mysql, pgsql, sqlite
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_task_manager
DB_USER=cloud_user
DB_PASSWORD=your_secure_db_password
DB_SSL=false
